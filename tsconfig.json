{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "./worker-configuration.d.ts",
      "@types/bun"
    ]
  },
  "include": [
    "src",
    "scripts"
  ]
}
