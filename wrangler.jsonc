{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-memory",
  "main": "src/index.service.ts",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "agent-memory" }
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "agent-memory" }],
  "ai": { "binding": "AI" },
  "vars": { "TRACK_ACCESS": "true" },
  // MCP_API_KEY is a secret (wrangler secret put MCP_API_KEY).
  "env": {
    "scratch": {
      "name": "agent-memory-scratch",
      "d1_databases": [{ "binding": "DB", "database_name": "agent-memory-scratch", "database_id": "local-scratch" }],
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "agent-memory-scratch", "remote": true }],
      "ai": { "binding": "AI", "remote": true },
      "vars": { "TRACK_ACCESS": "true" }
    },
    "readonly": {
      "name": "agent-memory-readonly",
      "d1_databases": [
        { "binding": "DB", "database_name": "agent-memory", "remote": true }
      ],
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "agent-memory", "remote": true }],
      "ai": { "binding": "AI", "remote": true },
      "vars": { "TRACK_ACCESS": "false" }
    }
  }
}
